#pragma code_page(65001)
#include <windows.h>
#include "src/resource.h"

IDI_APP ICON "assets/app.ico"
IDR_PLACEHOLDER RCDATA "assets/placeholder.png"
1 24 "app.manifest"

IDA_MAIN ACCELERATORS
BEGIN
    VK_SPACE, IDM_PLAY_TOGGLE, VIRTKEY
    "O", IDM_FILE_ADD, VIRTKEY, CONTROL
    "F", IDM_TOOLS_ONLINE_SEARCH, VIRTKEY, CONTROL
    VK_LEFT, IDM_PLAY_PREV, VIRTKEY, CONTROL
    VK_RIGHT, IDM_PLAY_NEXT, VIRTKEY, CONTROL
    VK_UP, IDM_VOLUME_UP, VIRTKEY, CONTROL
    VK_DOWN, IDM_VOLUME_DOWN, VIRTKEY, CONTROL
    VK_MEDIA_PLAY_PAUSE, IDM_MEDIA_PLAY_PAUSE, VIRTKEY
    VK_MEDIA_PREV_TRACK, IDM_MEDIA_PREV, VIRTKEY
    VK_MEDIA_NEXT_TRACK, IDM_MEDIA_NEXT, VIRTKEY
    VK_MEDIA_STOP, IDM_MEDIA_STOP, VIRTKEY
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 240
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "MS Shell Dlg"
BEGIN
    GROUPBOX "悬浮窗", -1, 10, 8, 280, 42
    CONTROL "拖到屏幕边缘松手后，自动缩成小封面", IDC_SET_SNAP, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 20, 23, 260, 14
    GROUPBOX "MP3 文件关联（只修改当前用户）", -1, 10, 58, 280, 102
    LTEXT "当前状态", IDC_SET_STATUS, 20, 73, 258, 20
    PUSHBUTTON "设为默认播放器", IDC_SET_REGISTER, 20, 96, 104, 20
    PUSHBUTTON "移除关联", IDC_SET_REMOVE, 132, 96, 82, 20
    LTEXT "双击 MP3 时：", -1, 20, 124, 68, 12
    CONTROL "打开主界面", IDC_SET_MODE_MAIN, "Button",
            BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 92, 123, 76, 14
    CONTROL "直达悬浮窗", IDC_SET_MODE_FLOAT, "Button",
            BS_AUTORADIOBUTTON | WS_TABSTOP, 174, 123, 94, 14
    LTEXT "Windows 10/11 可能由系统「默认应用」接管，如未生效请在系统设置中确认。",
          -1, 20, 142, 258, 16
    DEFPUSHBUTTON "确定", IDOK, 160, 214, 60, 20
    PUSHBUTTON "取消", IDCANCEL, 226, 214, 60, 20
END

IDD_MAKER DIALOGEX 0, 0, 520, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "歌词制作器"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "第一遍：边听边在右侧输入歌词行；第二遍：点「从头开始」，逐行打轴。回车添加行，F8 打轴。",
          -1, 10, 8, 500, 20
    PUSHBUTTON "播放", IDC_MAKER_PLAY, 10, 31, 60, 20
    PUSHBUTTON "从头开始", IDC_MAKER_RESTART, 76, 31, 80, 20
    LTEXT "00:00:00", IDC_MAKER_TIME, 164, 33, 90, 18
    CONTROL "", IDC_MAKER_SEEK, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,
            260, 31, 250, 20

    LISTBOX IDC_MAKER_LIST, 10, 58, 310, 238,
            WS_TABSTOP | WS_VSCROLL | LBS_NOTIFY | WS_BORDER

    GROUPBOX "第一遍 · 录入歌词", -1, 328, 52, 182, 80
    EDITTEXT IDC_MAKER_INPUT, 338, 68, 162, 20, WS_TABSTOP | ES_AUTOHSCROLL
    PUSHBUTTON "添加行", IDC_MAKER_ADD, 338, 94, 76, 22
    PUSHBUTTON "删除行", IDC_MAKER_DELETE, 420, 94, 80, 22

    GROUPBOX "第二遍 · 打轴", -1, 328, 140, 182, 106
    DEFPUSHBUTTON "打轴  F8", IDC_MAKER_TAP, 338, 156, 162, 28
    PUSHBUTTON "撤销", IDC_MAKER_UNDO, 338, 190, 76, 22
    PUSHBUTTON "保存 LRC", IDC_MAKER_SAVE, 420, 190, 80, 22
    LTEXT "双击已打轴的歌词可跳转试听。", -1, 338, 216, 162, 22

    PUSHBUTTON "导入 LRC", IDC_MAKER_IMPORT, 328, 258, 84, 22
    LTEXT "", IDC_MAKER_INFO, 328, 286, 182, 20
    PUSHBUTTON "关闭", IDC_MAKER_CLOSE, 442, 312, 66, 20
END

IDD_SERVER DIALOGEX 0, 0, 400, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "服务器设置"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "社区服务器地址 (http://host:port):", -1, 10, 10, 380, 12
    EDITTEXT IDC_SERVER_URL, 10, 26, 380, 18, WS_TABSTOP | ES_AUTOHSCROLL
    LTEXT "用户名:", -1, 10, 52, 80, 12
    EDITTEXT IDC_SERVER_USER, 10, 68, 180, 18, WS_TABSTOP | ES_AUTOHSCROLL
    LTEXT "密码:", -1, 210, 52, 80, 12
    EDITTEXT IDC_SERVER_PASS, 210, 68, 180, 18, WS_TABSTOP | ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON "测试连接", IDC_SERVER_TEST, 10, 96, 80, 22
    PUSHBUTTON "登录", IDC_SERVER_LOGIN, 100, 96, 60, 22
    PUSHBUTTON "注册", IDC_SERVER_REGISTER, 170, 96, 60, 22
    PUSHBUTTON "登出", IDC_SERVER_LOGOUT, 240, 96, 60, 22
    LTEXT "", IDC_SERVER_STATUS, 10, 128, 380, 20
    GROUPBOX "公开服务器 (无需登录)", -1, 10, 160, 380, 100
    CONTROL "使用公开模式 (无需登录即可搜索)", IDC_SERVER_PUBLIC, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 20, 175, 350, 14
    LTEXT "提示: 公开模式下任何人都可访问，私有模式需登录。", -1, 20, 195, 350, 30
    DEFPUSHBUTTON "确定", IDOK, 240, 270, 60, 20
    PUSHBUTTON "取消", IDCANCEL, 310, 270, 60, 20
END

IDD_ONLINE_SEARCH DIALOGEX 0, 0, 600, 450
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "在线搜索歌曲"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "搜索关键词:", -1, 10, 10, 80, 12
    EDITTEXT IDC_SEARCH_QUERY, 95, 8, 380, 18, WS_TABSTOP | ES_AUTOHSCROLL
    PUSHBUTTON "搜索", IDC_SEARCH_GO, 485, 6, 100, 22
    LTEXT "结果:", -1, 10, 40, 80, 12
    CONTROL "", IDC_SEARCH_RESULTS, "SysListView32",
            WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS,
            10, 56, 580, 320
    PUSHBUTTON "添加选中", IDC_SEARCH_ADD, 10, 390, 80, 22
    PUSHBUTTON "播放选中", IDC_SEARCH_PLAY, 100, 390, 80, 22
    PUSHBUTTON "下载选中", IDC_SEARCH_DOWNLOAD, 190, 390, 80, 22
    LTEXT "", IDC_SEARCH_STATUS, 10, 420, 580, 20
    PUSHBUTTON "关闭", IDCANCEL, 510, 390, 80, 22
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MAKASOUNDER"
            VALUE "FileDescription", "MAKASOUNDER offline audio player"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MAKASOUNDER"
            VALUE "OriginalFilename", "MAKASOUNDER.exe"
            VALUE "ProductName", "MAKASOUNDER"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
